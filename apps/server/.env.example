# PostgreSQL connection string
# Local dev (docker-compose): postgresql://postgres:password@localhost:5432/labas
DATABASE_URL=

# Redis — required for AI generation job queue
# Local dev (docker-compose): redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Auth — random strings, minimum 32 characters
BETTER_AUTH_SECRET=
# Local dev: http://localhost:3000
# Production: public URL of the API server (must match VITE_SERVER_URL on the web app)
# Example: https://api.example.com
BETTER_AUTH_URL=http://localhost:3000
# Local dev: http://localhost:3001
# Production: public URL of the web app (used for CORS + Better Auth trustedOrigins)
# Example: https://app.example.com
CORS_ORIGIN=http://localhost:3001

# Encrypts user AI API keys at rest — minimum 32 characters
API_KEY_ENCRYPTION_KEY=

# Environment mode — "development" (default) or "production"
# In development mode, Turnstile CAPTCHA is optional
# In production mode, CLOUDFLARE_TURNSTILE_SECRET_KEY is required
NODE_ENV=development

# Optional Google OAuth — set BOTH values and VITE_GOOGLE_AUTH_ENABLED=true to enable
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP — required for email verification and password reset.
# SMTP_USER/PASS may be empty for the loopback-only local Mailpit service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional email bounce webhook. Disabled when empty. Configure the ESP to send
# Authorization: Bearer <secret>; implement provider-specific signatures before public use.
EMAIL_BOUNCE_WEBHOOK_SECRET=

# Platform AI: configure on the server so customers can generate without API keys.
# Enable FREE_CREDITS_ENABLED after configuring and testing the provider.
# Each task reserves credits, enforces a shared model-call budget, then returns
# unused credits. Failed/cancelled tasks settle usage already incurred.
# Missing provider usage is conservatively estimated. Daily limits are defined
# in packages/api/src/lib/generation-policy.ts (UTC reset).
# PLATFORM_AI_API_KEY=
# PLATFORM_AI_BASE_URL=
# PLATFORM_AI_MODEL=

CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Set to "true" to bypass Turnstile CAPTCHA verification entirely
# Only use this temporarily if Cloudflare API is unreachable from your server
TURNSTILE_DISABLED=false

# Optional blog — leave both values empty to disable the external integration
# Optional: configure your own blog service before enabling the blog.
BLOG_API_URL=
BLOG_PROJECT_SLUG=
BLOG_API_KEY=
